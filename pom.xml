<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>jobtracker</groupId>
    <artifactId>job-tracker</artifactId>
    <version>0.1.0</version>
    <name>Job Tracker</name>
    <description>転職活動の応募状況を管理するデスクトップアプリ</description>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <javafx.version>21.0.5</javafx.version>
        <jackson.version>2.17.2</jackson.version>
        <jsoup.version>1.18.1</jsoup.version>
        <junit.version>5.10.3</junit.version>
        <main.class>jobtracker.Launcher</main.class>
    </properties>

    <dependencies>
        <!-- GUI -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <!-- HTML取得・解析 -->
        <dependency>
            <groupId>org.jsoup</groupId>
            <artifactId>jsoup</artifactId>
            <version>${jsoup.version}</version>
        </dependency>

        <!-- JSON保存 / JSON-LD解析 -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
            <version>${jackson.version}</version>
        </dependency>

        <!-- テスト -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.3.1</version>
            </plugin>
            <!-- mvn javafx:run で起動 -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>${main.class}</mainClass>
                </configuration>
            </plugin>
            <!-- mvn package で依存込みの実行可能jarを作成 (target/job-tracker.jar) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <finalName>job-tracker</finalName>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>${main.class}</mainClass>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            mvn clean package -Pexe で、Java 実行環境を同梱した exe を作る (Windows 用)。
            出力: target/dist/JobTracker/JobTracker.exe (フォルダごと配布・配置する)
            JDK 付属の jpackage を使う。インストーラーではないので WiX は不要
        -->
        <profile>
            <id>exe</id>
            <properties>
                <app.name>JobTracker</app.name>
                <jpackage.input>${project.build.directory}/jpackage-input</jpackage.input>
                <jpackage.dest>${project.build.directory}/dist</jpackage.dest>
                <!--
                    jdeps の結果 (java.base, java.desktop, java.scripting, java.sql, jdk.jfr, jdk.unsupported) に、
                    実行時にだけ必要になるものを足している
                    - jdk.crypto.mscapi : Windows の証明書ストア (Windows-ROOT) を使う
                    - jdk.crypto.ec     : HTTPS の楕円曲線暗号
                    - jdk.localedata    : 日付の曜日を日本語で表示する
                -->
                <jpackage.modules>java.base,java.desktop,java.scripting,java.sql,java.logging,jdk.jfr,jdk.unsupported,jdk.crypto.mscapi,jdk.crypto.ec,jdk.localedata,jdk.charsets</jpackage.modules>
            </properties>
            <build>
                <plugins>
                    <!-- jpackage は input フォルダの中身を全部同梱するので、jar だけを入れたフォルダを用意する -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-resources-plugin</artifactId>
                        <version>3.3.1</version>
                        <executions>
                            <execution>
                                <id>copy-jar-for-jpackage</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>copy-resources</goal>
                                </goals>
                                <configuration>
                                    <outputDirectory>${jpackage.input}</outputDirectory>
                                    <resources>
                                        <resource>
                                            <directory>${project.build.directory}</directory>
                                            <includes>
                                                <include>job-tracker.jar</include>
                                            </includes>
                                            <filtering>false</filtering>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.5.0</version>
                        <executions>
                            <execution>
                                <id>jpackage</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <!-- Maven を動かしている JDK の jpackage を使う -->
                                    <executable>${java.home}/bin/jpackage</executable>
                                    <arguments>
                                        <argument>--type</argument>
                                        <argument>app-image</argument>
                                        <argument>--name</argument>
                                        <argument>${app.name}</argument>
                                        <argument>--app-version</argument>
                                        <argument>${project.version}</argument>
                                        <argument>--description</argument>
                                        <argument>${project.description}</argument>
                                        <argument>--input</argument>
                                        <argument>${jpackage.input}</argument>
                                        <argument>--main-jar</argument>
                                        <argument>job-tracker.jar</argument>
                                        <argument>--main-class</argument>
                                        <argument>${main.class}</argument>
                                        <argument>--dest</argument>
                                        <argument>${jpackage.dest}</argument>
                                        <argument>--add-modules</argument>
                                        <argument>${jpackage.modules}</argument>
                                        <!-- 既定の jlink オプションに、ロケールを日本語・英語だけに絞る指定を足してサイズを減らす -->
                                        <argument>--jlink-options</argument>
                                        <argument>--strip-native-commands --strip-debug --no-man-pages --no-header-files --include-locales=ja,en</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
