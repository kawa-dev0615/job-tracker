<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- 応募管理タブ。コントローラ (MainController) はコード側で設定する -->
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">

    <top>
        <VBox spacing="12">
            <padding><Insets top="12" right="20" bottom="0" left="20"/></padding>

            <!-- 求人URL入力 -->
            <HBox spacing="8" alignment="CENTER_LEFT">
                <TextField fx:id="urlField" HBox.hgrow="ALWAYS"
                           promptText="求人ページのURLを貼り付けてください (https://...)"
                           onAction="#onAnalyze"/>
                <ProgressIndicator fx:id="progress" visible="false" prefWidth="22" prefHeight="22"/>
                <Button fx:id="analyzeButton" text="解析して追加" styleClass="primary-button" onAction="#onAnalyze"/>
                <Button fx:id="manualAddButton" text="手動で追加" onAction="#onManualAdd"/>
            </HBox>

            <!-- ステータス別タブ (中身はコントローラで生成) -->
            <HBox fx:id="statusTabs" styleClass="status-tabs" spacing="2"/>
        </VBox>
    </top>

    <center>
        <TableView fx:id="table" styleClass="job-table">
            <BorderPane.margin><Insets left="20" right="8"/></BorderPane.margin>
            <!-- 列幅をテーブル幅に収める。幅固定の列以外 (会社名・ポジション・想定年収・備考) で伸縮する -->
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS"/></columnResizePolicy>
            <columns>
                <TableColumn fx:id="appliedDateColumn" text="応募日" prefWidth="95" minWidth="95" maxWidth="95" resizable="false"/>
                <TableColumn fx:id="companyColumn" text="会社名" prefWidth="200" minWidth="90"/>
                <TableColumn fx:id="positionColumn" text="ポジション" prefWidth="230" minWidth="110"/>
                <TableColumn fx:id="salaryColumn" text="想定年収" prefWidth="170" minWidth="100"/>
                <TableColumn fx:id="statusColumn" text="ステータス" prefWidth="140" minWidth="140" maxWidth="140" resizable="false"/>
                <TableColumn fx:id="interviewColumn" text="面接日時" prefWidth="150" minWidth="150" maxWidth="150" resizable="false"/>
                <TableColumn fx:id="noteColumn" text="備考" prefWidth="200" minWidth="90" sortable="false"/>
                <TableColumn fx:id="urlColumn" text="求人" prefWidth="60" minWidth="60" maxWidth="60" resizable="false" sortable="false"/>
            </columns>
        </TableView>
    </center>

    <right>
        <VBox spacing="8" prefWidth="230" styleClass="side-panel">
            <BorderPane.margin><Insets right="20"/></BorderPane.margin>
            <Label text="今後の面接予定" styleClass="side-title"/>
            <ListView fx:id="upcomingList" VBox.vgrow="ALWAYS" styleClass="upcoming-list"/>
        </VBox>
    </right>
</BorderPane>
